# ==============================================================================
# Agentic AI Assistant — Production Configuration Template (.env.example)
# ==============================================================================

# LLM Runtime Configuration
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_REASONING=0

# Planning & Orchestration (V1 Production Baseline)
PLANNING_STRATEGY=hybrid
MAX_EXECUTION_STEPS=10
RESULT_AWARE_REPLANNING=on
PLANNER_COMPLETION_CONTEXT=on
GOAL_FULFILLMENT_GUARD=on
MCP_ARGUMENT_REPAIR=on
DISCOVERY_STRATEGY=none

# Resilience & Timeouts (Seconds)
TIMEOUT_LLM_S=120
TIMEOUT_TOOL_S=10
TIMEOUT_MCP_S=10
TIMEOUT_WEB_SEARCH_S=10
MAX_RETRIES=1
MAX_TOOL_FAILURES_PER_TOOL=3
MAX_ARGUMENT_REPAIR_ATTEMPTS=1

# Model Context Protocol (MCP) Servers
MCP_SERVERS=[{"name": "calendar", "transport": "stdio", "command": "python", "args": ["mcp_calendar_server.py"]}, {"name": "notes", "transport": "stdio", "command": "python", "args": ["mcp_notes_server.py"]}, {"name": "reminders", "transport": "stdio", "command": "python", "args": ["mcp_reminders_server.py"]}, {"name": "filesystem", "transport": "stdio", "command": "python", "args": ["mcp_filesystem_server.py"]}, {"name": "google_calendar", "transport": "stdio", "command": "python", "args": ["google_calendar_server.py"]}, {"name": "gmail", "transport": "stdio", "command": "python", "args": ["gmail_server.py"]}]

# Google OAuth configuration for external Google MCP servers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CREDENTIALS_FILE=
GOOGLE_TOKEN_FILE=.google_token.json
GMAIL_TOKEN_FILE=.gmail_token.json
